# Application configuration. Copy to .env for local development.
APP_ENV=development
SERVICE_NAME=saas-platform
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
METRICS_ENABLED=true
WORKER_METRICS_PORT=9001
POSTGRES_HOST_PORT=5432

# Runtime and worker credentials are deliberately separate. These values are
# local placeholders only and must never be reused outside development.
DATABASE_URL=postgresql+psycopg://app_runtime:development-only-runtime@127.0.0.1:5432/saas_platform
DATABASE_WORKER_URL=postgresql+psycopg://app_worker:development-only-worker@127.0.0.1:5432/saas_platform
DATABASE_ADMIN_URL=postgresql+psycopg://app_owner:development-only-owner@127.0.0.1:5432/saas_platform
DATABASE_MIGRATION_URL=postgresql+psycopg://app_owner:development-only-owner@127.0.0.1:5432/saas_platform

# Test-only/internal adapter. Production configuration must keep it disabled.
SYNTHETIC_ADAPTER_ENABLED=true
SYNTHETIC_ADAPTER_TOKEN=replace-with-at-least-24-local-characters

# PostgreSQL-backed queue settings for Iteration 1 only (ADR-017).
QUEUE_POLL_INTERVAL_MS=250
QUEUE_LEASE_SECONDS=30
QUEUE_MAX_ATTEMPTS=3
