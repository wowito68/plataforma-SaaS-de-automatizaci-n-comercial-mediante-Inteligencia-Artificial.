# Application configuration. Copy to .env for local development.
APP_ENV=development
SERVICE_NAME=saas-platform
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
METRICS_ENABLED=true
WORKER_METRICS_PORT=9001
POSTGRES_HOST_PORT=5432

# Runtime and worker credentials are deliberately separate. These values are
# local placeholders only and must never be reused outside development.
DATABASE_URL=postgresql+psycopg://app_runtime:development-only-runtime@127.0.0.1:5432/saas_platform
DATABASE_WORKER_URL=postgresql+psycopg://app_worker:development-only-worker@127.0.0.1:5432/saas_platform
DATABASE_ADMIN_URL=postgresql+psycopg://app_owner:development-only-owner@127.0.0.1:5432/saas_platform
DATABASE_MIGRATION_URL=postgresql+psycopg://app_owner:development-only-owner@127.0.0.1:5432/saas_platform

# Test-only/internal adapter. Production configuration must keep it disabled.
SYNTHETIC_ADAPTER_ENABLED=true
SYNTHETIC_ADAPTER_TOKEN=replace-with-at-least-24-local-characters

# Normalized conversation adapter for local/internal validation only.
# It is rejected by configuration in production.
CONVERSATION_ADAPTER_ENABLED=true
CONVERSATION_ADAPTER_TOKEN=replace-with-at-least-24-local-characters

# Structured AI extraction is opt-in. Leave the key empty while disabled.
AI_EXTRACTION_ENABLED=false
AI_EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
AI_EXTRACTION_MODEL=gpt-5.6-terra
AI_EXTRACTION_TIMEOUT_SECONDS=20
AI_EXTRACTION_MAX_RETRIES=1
AI_EXTRACTION_MAX_OUTPUT_TOKENS=4000
AI_EXTRACTION_CONTEXT_MAX_MESSAGES=12
AI_EXTRACTION_CONTEXT_MAX_CHARACTERS=12000
AI_EXTRACTION_SUMMARY_MAX_CHARACTERS=2000
AI_EXTRACTION_CONTEXT_MAX_AGE_DAYS=30
AI_EXTRACTION_AUTO_ACCEPT_CONFIDENCE=0.85
AI_EXTRACTION_PROVISIONAL_CONFIDENCE=0.65
AI_EXTRACTION_CONFIRMATION_CONFIDENCE=0.40
AI_EXTRACTION_LOG_CONTENT=false
# Optional operational rates; set only from an approved current price sheet.
# AI_EXTRACTION_INPUT_COST_PER_MILLION_USD=0
# AI_EXTRACTION_OUTPUT_COST_PER_MILLION_USD=0

# PostgreSQL-backed queue settings for Iteration 1 only (ADR-017).
QUEUE_POLL_INTERVAL_MS=250
QUEUE_LEASE_SECONDS=30
QUEUE_MAX_ATTEMPTS=3

# Delivery 3 PostgreSQL message claims and transactional outbox.
CONVERSATION_PROCESSING_LEASE_SECONDS=120
CONVERSATION_PROCESSING_MAX_ATTEMPTS=3
CONVERSATION_WORKER_BATCH_SIZE=10
CONVERSATION_OUTBOX_BATCH_SIZE=50
CONVERSATION_OUTBOX_LEASE_SECONDS=30
CONVERSATION_OUTBOX_MAX_ATTEMPTS=5
